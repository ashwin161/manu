# GEMINI_API_KEY: Required for Gemini AI petition generation (gemini-3.8-flash)
# In Vercel: Project Settings -> Environment Variables -> add GEMINI_API_KEY
GEMINI_API_KEY="your-gemini-api-key"

# Vercel / App Host URL
APP_URL="https://your-app-name.vercel.app"

# Optional Firebase Configuration (if using custom Firebase Project instead of default fallback)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
