rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPetition(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.department is string && data.department.size() <= 256
        && data.tanglishInput is string && data.tanglishInput.size() <= 15000
        && data.tamilOutput is map
        && data.englishOutput is map
        && data.keys().hasAll(['userId', 'department', 'tanglishInput', 'tamilOutput', 'englishOutput', 'createdAt'])
        && data.keys().hasOnly(['userId', 'department', 'tanglishInput', 'tamilOutput', 'englishOutput', 'createdAt', 'applicantName', 'applicantPhone', 'applicantAddress']);
    }

    match /petitions/{petitionId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(petitionId)
        && request.resource.data.userId == request.auth.uid
        && isValidPetition(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() 
        && isValidId(petitionId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && isValidPetition(request.resource.data);
      allow delete: if isSignedIn() 
        && isValidId(petitionId) 
        && resource.data.userId == request.auth.uid;
    }
  }
}
